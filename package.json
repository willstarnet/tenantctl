{
  "name": "m365-cli",
  "version": "0.1.0",
  "description": "Agent-friendly Microsoft 365 administration CLI over Microsoft Graph (Entra, Intune, Defender, SharePoint, Exchange, Teams).",
  "type": "module",
  "private": true,
  "bin": {
    "m365": "./src/cli.ts"
  },
  "scripts": {
    "m365": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "docs": "bun run scripts/gen-docs.ts && oxfmt -c .oxfmtrc.json docs/COMMANDS.md docs/PERMISSIONS.md",
    "format": "oxfmt -c .oxfmtrc.json .",
    "format:check": "oxfmt -c .oxfmtrc.json --check .",
    "build": "bun run scripts/build.ts",
    "install:local": "bun run scripts/build.ts --install",
    "smoke:live": "bun run scripts/smoke-live.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.78.0",
    "typescript": "^7.0.2"
  }
}
